rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper function
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User profile images
    match /users/{userId}/{allPaths=**} {
      allow read: if true; // Public
      allow write: if isOwner(userId);
    }

    // Barber images (profile, cover, portfolio)
    match /barbers/{barberId}/{allPaths=**} {
      allow read: if true; // Public
      allow write: if isOwner(barberId);
    }

    // Post images
    match /posts/{userId}/{allPaths=**} {
      allow read: if true; // Public posts
      allow write: if isOwner(userId);
    }

    // Story media
    match /stories/{userId}/{allPaths=**} {
      allow read: if isSignedIn(); // Stories visible to authenticated users
      allow write: if isOwner(userId);
    }

    // Message media (images sent in chat)
    match /messages/{conversationId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() &&
                     request.resource.size < 10 * 1024 * 1024 && // 10MB max for message images
                     request.resource.contentType.matches('image/.*'); // Only images
    }

    // Review images
    match /reviews/{reviewId}/{allPaths=**} {
      allow read: if true; // Public
      allow write: if isSignedIn();
    }

    // General size limits (10MB for images, 25MB for videos)
    match /{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() &&
                     request.resource.size < 25 * 1024 * 1024 && // 25MB max
                     request.resource.contentType.matches('image/.*|video/.*');
    }
  }
}
